2026],"races":["2026/4"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/all-the-liveries-special-helmet-designs-and-eye-catching-looks-for-miami.7oF76lk9j3Og4NMq8G4duU"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/8fde2a3a61f810269286fbc2.webp","width":1200,"height":675,"bytes":154688,"caption":"迈阿密特别装备与涂装 · 官方报道配图","source":"https://www.formula1.com/en/latest/article/all-the-liveries-special-helmet-designs-and-eye-catching-looks-for-miami.7oF76lk9j3Og4NMq8G4duU"}},{"topic":"news-382c1c4386535041-2","title":"博塔斯90年代迈阿密头盔","text":"博塔斯让伴侣、自行车手蒂芙尼·克伦威尔设计迈阿密头盔，薄荷绿和淡紫色搭配孟菲斯图案、复古元素和粉色凯迪拉克插图，车号用Comic Sans字体。","tag":"车手装备","dimension":"visual","year":2026,"publishedAt":"2026-05-01T13:10:27.884Z","temporal":"event","status":"confirmed","related":{"drivers":["valtteri-bottas"],"teams":["cadillac"],"seasons":[2026],"races":["2026/4"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/all-the-liveries-special-helmet-designs-and-eye-catching-looks-for-miami.7oF76lk9j3Og4NMq8G4duU"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/8fde2a3a61f810269286fbc2.webp","width":1200,"height":675,"bytes":154688,"caption":"官方报道配图","source":"https://www.formula1.com/en/latest/article/all-the-liveries-special-helmet-designs-and-eye-catching-looks-for-miami.7oF76lk9j3Og4NMq8G4duU"}},{"topic":"paddock-extra-0","title":"拉塞尔先选到了“最快的卡丁车”","text":"拉塞尔说，他请当地人推荐卡丁车，对方还装了新轮胎。他形容自己的车快得让朋友们纷纷抗议，这场娱乐赛很快变成了混战。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-01T15:18:32.911Z","temporal":"event","status":"statement","related":{"drivers":["george-russell"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}],"verifiedAt":"2026-10-14"},{"topic":"paddock-extra-1","title":"场外是朋友，戴上头盔还是对手","text":"诺里斯认为，车手可以区分赛道内外的相处。一起度假不一定让比赛更温和，他反而觉得有时竞争会更激烈。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-01T15:18:32.911Z","temporal":"event","status":"statement","related":{"drivers":["lando-norris"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}],"verifiedAt":"2026-10-14"},{"topic":"paddock-extra-2","title":"私人纪录片的镜头也跟着团建","text":"F1官方报道提到，拉塞尔分享的照片里，诺里斯带着摄像机，正在为自己的个人纪录片收集素材；同框还能看到摄影和收音人员。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-01T15:18:32.911Z","temporal":"event","status":"statement","related":{"drivers":["lando-norris","george-russell"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}],"verifiedAt":"2026-10-14"},{"topic":"news-627eb88141127136-0","title":"汉密尔顿力推F1非洲赛","text":"汉密尔顿表示：“我一直说我们需要在非洲举办大奖赛。对我来说，这是最重要、最美丽的大洲。我们去了所有其他大洲，却没有非洲，这没有理由。”他透露一直在幕后推动此事。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-13T09:45:46.499Z","temporal":"event","status":"confirmed","related":{"drivers":["lewis-hamilton"],"teams":[],"seasons":[2026],"races":[]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/02a62075ea00b0fbd0702cc3.webp","width":1200,"height":675,"bytes":147294,"caption":"官方报道配图","source":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}},{"topic":"news-627eb88141127136-1","title":"维斯塔潘期待非洲赛","text":"维斯塔潘表示：“如果可能的话，那就太好了。我们希望在世界各地比赛，所以我真的希望它能推进。我去过卢旺达一次。但让我们等等看，看看是否一切都能实现。如果成真，我们都会非常兴奋。”","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-13T09:45:46.499Z","temporal":"event","status":"confirmed","related":{"drivers":["max-verstappen"],"teams":[],"seasons":[2026],"races":[]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/02a62075ea00b0fbd0702cc3.webp","width":1200,"height":675,"bytes":147294,"caption":"官方报道配图","source":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}},{"topic":"news-627eb88141127136-2","title":"拉塞尔支持F1重返非洲","text":"拉塞尔表示：“今年早些时候我在非洲，我真的很喜欢那里的时光。F1是一项世界性运动。非洲是我们唯一没有比赛的大洲，是时候在那里举办比赛了。”","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-13T09:45:46.499Z","temporal":"event","status":"confirmed","related":{"drivers":["george-russell"],"teams":[],"seasons":[2026],"races":[]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/02a62075ea00b0fbd0702cc3.webp","width":1200,"height":675,"bytes":147294,"caption":"官方报道配图","source":"https://www.formula1.com/en/latest/article/everything-we-know-about-f1s-all-new-race-in-rwanda.3Mde3s9FqIOTbkzKs0Puwo"}}],"liveries":[{"id":"news-a2aa26793f82d0d4-0","chassis":"audi-r26","year":2026,"rounds":[17],"kind":"special","name":"新加坡特别涂装","description":"奥迪为新加坡大奖赛推出特别涂装，R26赛车侧箱和尾翼采用融合新加坡土生华人图案的设计，车手霍肯伯格和博托莱托的赛服也将沿用此图案。","source":"https://www.formula1.com/en/latest/a