sell"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/366253e3098f0f309bcfbea9.webp","width":1200,"height":675,"bytes":167094,"caption":"车手公开动态 · 来源 F1 官方报道","source":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}},{"topic":"paddock-extra-1","title":"场外是朋友，戴上头盔还是对手","text":"诺里斯认为，车手可以区分赛道内外的相处。一起度假不一定让比赛更温和，他反而觉得有时竞争会更激烈。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-01T15:18:32.911Z","temporal":"event","status":"statement","related":{"drivers":["lando-norris"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}],"verifiedAt":"2026-10-14","photo":{"url":"https://raw.githubusercontent.com/championwang00/pitwall-f1/codex/editorial-news/images/366253e3098f0f309bcfbea9.webp","width":1200,"height":675,"bytes":167094,"caption":"车手公开动态 · 来源 F1 官方报道","source":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside-carlos-sainzs-f1-training-camp.3NUu7MqKEugEvgjb41pPt0"}},{"topic":"paddock-extra-2","title":"私人纪录片的镜头也跟着团建","text":"F1官方报道提到，拉塞尔分享的照片里，诺里斯带着摄像机，正在为自己的个人纪录片收集素材；同框还能看到摄影和收音人员。","tag":"场外动态","dimension":"personality","year":2026,"publishedAt":"2026-10-01T15:18:32.911Z","temporal":"event","status":"statement","related":{"drivers":["lando-norris","george-russell"],"teams":[],"seasons":[2026],"races":["2026/16"]},"sources":[{"label":"F1 官方","url":"https://www.formula1.com/en/latest/article/karting-chaos-cycling-tours-and-chess-inside